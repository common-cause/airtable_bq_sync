# .env.example — env keys for airtable-bq-sync. Copy to .env and fill in values.
# Regenerated by sync_projects.py --regen-env-examples; key metadata lives in the
# meta-project's credential_catalog.yaml. [central] secrets are filled automatically
# from the meta .env by --setup / --reseed-credentials.

# BigQuery service account JSON (full JSON string, unquoted)  [central — seeded from the meta .env]
BIGQUERY_CREDENTIALS_PASSWORD=

# Airtable personal access token  [central — seeded from the meta .env]
AIRTABLE_API_KEY_PASSWORD=
